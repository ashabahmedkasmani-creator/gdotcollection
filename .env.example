# Public canonical URL of the deployed site (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://example.com
# URL of the live WooCommerce store that handles real checkout
NEXT_PUBLIC_STORE_URL=https://gdotcollection.com
# Server-side only. Needed only if you replace the static catalogue with the WooCommerce REST API.
WC_CONSUMER_KEY=ck_replace_me
WC_CONSUMER_SECRET=cs_replace_me
